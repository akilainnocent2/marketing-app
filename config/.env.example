DEBUG=true
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Codespaces automatically trusts this workspace on port 8000. Add other app ports if needed.
CODESPACE_APP_PORTS=8000
POSTGRES_DB=marketing
POSTGRES_USER=marketing
MARKETING_DB_PASSWORD=replace-with-database-role-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# To explicitly use SQLite for isolated development: DB_ENGINE=sqlite3
# SQLITE_PATH=/absolute/path/to/db.sqlite3
# Set DEBUG=false and valid HTTPS hosts for production.
# Password reset controls are enabled only when EMAIL_HOST is configured.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@example.com

# Shop identity handoff; set the same independently generated secret in both apps.
SHOP_APP_URL=https://shop.britishschool.ac.tz
MARKETING_APP_URL=https://marketing.britishschool.ac.tz
BRITISHSCHOOL_SHOP_MARKETING_SSO_SECRET=
